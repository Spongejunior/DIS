# Environment Variables Template for Vercel Deployment
# Copy this file as .env.local for local development
# Set these variables in your Vercel project settings for production

# ============================================================================
# REQUIRED - Flask Configuration
# ============================================================================

# Flask environment (development, production, testing)
FLASK_ENV=production
FLASK_CONFIG=production

# Secret key for session encryption - MUST be a random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-key-here-change-in-production

# ============================================================================
# REQUIRED - Database Configuration
# ============================================================================

# PostgreSQL connection string (recommended for production)
# Format: postgresql://username:password@host:port/database_name
# Examples:
#   - Neon: postgresql://user:password@ep-xyz.us-east-1.neon.tech:5432/dbname
#   - AWS RDS: postgresql://user:password@mydb.xxxxx.us-east-1.rds.amazonaws.com:5432/dbname
# If not set, defaults to SQLite (sqlite:///database.db)
DATABASE_URL=postgresql://user:password@host:port/database_name

# ============================================================================
# REQUIRED - Email Configuration (Gmail SMTP)
# ============================================================================

# Gmail account email (or another SMTP email provider)
MAIL_USERNAME=your-email@gmail.com

# Gmail app-specific password (NOT your main Gmail password!)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your-app-specific-password

# Default sender email address
MAIL_DEFAULT_SENDER=noreply@yourapp.com

# Set to 'false' in production to enable email sending (default is 'true' to suppress)
MAIL_SUPPRESS_SEND=false

# ============================================================================
# OPTIONAL - File Upload Configuration
# ============================================================================

# Upload folder path (defaults to /tmp/uploads for Vercel)
# For local development, you might want: ./uploads
UPLOAD_FOLDER=/tmp/uploads

# ============================================================================
# OPTIONAL - Cloud Storage (for production file persistence)
# ============================================================================

# AWS S3 Configuration (if using S3 for persistent file storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1

# ============================================================================
# OPTIONAL - Monitoring & Logging
# ============================================================================

# Enable debug mode (set to 'true' only in development)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL - Application Settings
# ============================================================================

# Application name
APP_NAME=Animal Health System

# Application version
VERSION=2.1.4

# ============================================================================
# NOTES FOR VERCEL DEPLOYMENT
# ============================================================================
#
# 1. Never commit .env or .env.local to Git (already in .gitignore)
#
# 2. Add environment variables to Vercel:
#    - Go to Project Settings → Environment Variables
#    - Add each variable for Production environment
#    - Variables can be different for Preview and Development
#
# 3. Database Setup:
#    - For free hosting, use Neon PostgreSQL (https://neon.tech)
#    - Create a project and copy the connection string
#    - Add as DATABASE_URL in Vercel
#
# 4. Email Setup:
#    - Enable 2-Step Verification on your Gmail account
#    - Go to https://myaccount.google.com/apppasswords
#    - Generate an app-specific password for "Mail" and "Windows"
#    - Use this password as MAIL_PASSWORD (not your Gmail password!)
#    - Or use SendGrid/Mailgun as alternatives
#
# 5. Security:
#    - SECRET_KEY: Generate with python -c "import secrets; print(secrets.token_hex(32))"
#    - Store all sensitive values in Vercel environment variables, NEVER in code
#    - Use HTTPS only (Vercel provides this automatically)
#
# 6. Testing:
#    - Copy this file to .env.local for local development
#    - Do NOT add .env.local to Git
#    - Reload VS Code after adding .env.local
#
# ============================================================================
